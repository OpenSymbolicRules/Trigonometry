{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.3",
  "title": "Double Angle Identity Tests",
  "tests": [
    {
      "id": 1,
      "expression": ["Sin", ["Multiply", 2, "x"]],
      "variable": "x",
      "expected_result": ["Multiply", 2, ["Sin", "x"], ["Cos", "x"]],
      "num_steps": 1,
      "grade": "A"
    },
    {
      "id": 2,
      "expression": ["Cos", ["Multiply", 2, "x"]],
      "variable": "x",
      "expected_result": ["Subtract", ["Power", ["Cos", "x"], 2], ["Power", ["Sin", "x"], 2]],
      "num_steps": 1,
      "grade": "A"
    }
  ]
}
